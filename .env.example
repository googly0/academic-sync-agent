# Copy to `.env` and fill in. `.env` is gitignored.
# Everything here is optional if the value is already in your real environment.

# --- Stage 2: LLM backend --------------------------------------------------
# Needed only for --llm-backend anthropic (the default).
# Not needed for --llm-backend ollama or --llm-backend stub.
#
# You can also skip this entirely and run `ant auth login` instead — the SDK
# picks up the stored profile automatically.
ANTHROPIC_API_KEY=sk-ant-...

# --- Stage 5: Google Calendar ---------------------------------------------
# These are FILE PATHS, not secrets. The files themselves are gitignored.
# See the README for how to obtain credentials.json.
# GOOGLE_CREDENTIALS_PATH=credentials.json
# GOOGLE_TOKEN_PATH=token.json

# --- OCR (stage 1) ---------------------------------------------------------
# Only needed if poppler is installed somewhere unusual.
# POPPLER_PATH=/opt/homebrew/bin
