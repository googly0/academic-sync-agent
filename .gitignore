# NOTE: git does NOT support trailing comments on pattern lines.
# `token.json   # a comment` is read as a literal filename, matching nothing.
# Every comment below therefore sits on its own line.

# --- Secrets and credentials — never commit these -------------------------
.env
*.pem

# Google OAuth client secrets
credentials.json

# Cached OAuth token — this is a live credential
token.json

# --- Run artefacts --------------------------------------------------------

# Checkpoint; machine-specific, safe to delete
sync_state.json

# extracted_tasks.json, needs_review.json
output/

*.log

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# --- OS -------------------------------------------------------------------
.DS_Store
