output/                   # extracted_tasks.json, needs_review.json
*.log

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# --- OS -------------------------------------------------------------------
.DS_Store
