# NOTE: git does NOT support trailing comments on pattern lines.
# `token.json   # a comment` is read as a literal filename, matching nothing.
# Every comment below therefore sits on its own line.

# --- Secrets and credentials — never commit these -------------------------
.env
*.pem

# `.env` alone does not match .env.local / .env.production
.env.*
!.env.example

# Google OAuth client secrets
credentials.json

# Google Cloud Console downloads the same file as
# client_secret_<id>.apps.googleusercontent.com.json. The README says to rename
# it, but the un-renamed copy is a live credential and must not depend on that.
client_secret*.json

# Cached OAuth token — this is a live credential
token.json

# --- Run artefacts --------------------------------------------------------

# Checkpoint; machine-specific, safe to delete
sync_state.json

# extracted_tasks.json, needs_review.json
output/

# Web app workspace: your tasks, sync records, and possibly a Notion token
academic_sync.db
academic_sync.db-*

*.log

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# --- OS -------------------------------------------------------------------
.DS_Store
